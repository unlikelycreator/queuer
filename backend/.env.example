# ─── Core ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/zoopdesk

# Use a long random string (32+ chars — required in production).
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRE=7d

# Frontend URL(s). Used for CORS and to build links in emails (password reset,
# ticket tracking, client portal). Comma-separate multiple origins if needed.
CLIENT_URL=http://localhost:5173

# Public base URL of THIS backend (for attachment links from incoming email).
PUBLIC_API_URL=http://localhost:5000

# Encrypts IMAP passwords and 2FA secrets at rest. Set once and never change it,
# or saved mailbox passwords / 2FA setups can no longer be decrypted.
ENCRYPTION_KEY=change_this_to_a_different_long_random_string

# Name shown in authenticator apps and account emails.
APP_NAME=ZoopDesk

# ─── Platform email (password resets & account emails) ───────────────
# Optional but recommended in production. If unset, ZoopDesk falls back to the
# user's company mailbox (Settings → Support mailbox), and in development it
# prints the email (including reset links) to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ZoopDesk <no-reply@yourdomain.com>"

# ─── Support inbox polling ───────────────────────────────────────────
EMAIL_POLL_INTERVAL_MS=60000
# Set to false to disable IMAP polling on this instance (e.g. extra API replicas).
EMAIL_POLLING=true

# ─── Google Sign-In (optional) ───────────────────────────────────────
# OAuth Client ID (Web) from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# ─── Deployment ──────────────────────────────────────────────────────
# Behind Nginx / a load balancer, leave this on so rate limits see real client IPs.
TRUST_PROXY=true
# Serve the built frontend (../frontend/dist) from this server — single-process deploys.
SERVE_FRONTEND=false
